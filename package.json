{
  "name": "dsh-meal-picker",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：悬浮气泡「今天吃什么」—— 本地加权随机推荐菜品，点一下 0 token",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wcytjy/dsh-meal-picker.git"
  },
  "homepage": "https://github.com/wcytjy/dsh-meal-picker",
  "bugs": {
    "url": "https://github.com/wcytjy/dsh-meal-picker/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./core": {
      "default": "./lib/core.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "data",
    "assets",
    "cordis.patch.yml",
    "install.ps1",
    "uninstall.ps1",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/",
    "test:core": "node --test test/core.test.js",
    "test:host": "node --test test/host.test.js",
    "test:client": "node --test test/client.test.js"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "meal",
    "food",
    "今天吃什么"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <4.0.1 || >=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc.1 <0.1.0-0 || >=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.1 <0.1.2-0 || >=0.1.2-rc.1 <0.1.3-0 || >=0.1.3-rc.1 <0.1.4-0 || >=0.1.4-rc.1 <0.1.5-0 || >=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-rc.1 <0.2.0-0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
